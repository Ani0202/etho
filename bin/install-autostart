#!/usr/bin/env bash
# Install the hosting cron entries: the public uptime check every 15 minutes and the Funnel keepalive every 5 minutes
# (docs/HOSTING.md sections 10 and 11).
#
# Safe to re-run. It owns exactly two lines: those that run THIS checkout's bin/uptime-check or bin/funnel-keepalive.
# Those are replaced in place; every other crontab line (other jobs, comments, blank lines, other checkouts' entries)
# is kept byte for byte and in its original order. If the current crontab cannot be read (any error other than "no crontab
# for <user>"), nothing is written. ETHO_CRONTAB overrides the crontab binary (tests use a fake one).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
crontab_bin="${ETHO_CRONTAB:-crontab}"
own_a="$root/bin/uptime-check"
own_b="$root/bin/funnel-keepalive"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
rc=0
"$crontab_bin" -l >"$tmp/cur" 2>"$tmp/err" || rc=$?
if [ "$rc" -ne 0 ]; then
  if grep -qi "no crontab" "$tmp/err"; then
    : >"$tmp/cur"
  else
    echo "install-autostart: cannot read the current crontab (exit $rc): $(cat "$tmp/err"); nothing changed" >&2
    exit 1
  fi
fi

# Every line that is not ours (comments are never ours) is copied unchanged and in order. Our two lines go where the
# first of our old lines was (so re-running on an up-to-date crontab changes nothing), or at the end if there was none.
ours_1="*/15 * * * * $own_a >> $root/ops/uptime.cron.log 2>&1"
ours_2="*/5 * * * * $own_b >> $root/ops/funnel-keepalive.log 2>&1"
awk -v a="$own_a" -v b="$own_b" -v l1="$ours_1" -v l2="$ours_2" -v keptf="$tmp/kept" '
  !/^[[:space:]]*#/ && (index($0, a) || index($0, b)) { if (!done) { print l1; print l2; done = 1 } ; next }
  { print; kept++ }
  END { if (!done) { print l1; print l2 } ; print kept + 0 > keptf }' "$tmp/cur" >"$tmp/new"
kept=$(cat "$tmp/kept")
"$crontab_bin" - <"$tmp/new"
echo "installed 2 hosting lines; kept $kept other line(s) unchanged"
"$crontab_bin" -l | grep -F -e "$own_a" -e "$own_b"
