#!/usr/bin/env python3
"""Queued Codex requests (ops/codex/queue/). Never waits, never loops.

  bin/codex-queue           list queued requests, model limits, and unsent notifications
  bin/codex-queue --drain   run what is runnable now, gates first, then oldest first; each item is
                            attempted at most once per drain. Routine reviews whose heads form one
                            history line are coalesced into a single review (oldest base, newest
                            head); the merged-away items are resolved only after it succeeds. Failed
                            items back off 1 h and are dropped after 3 attempts (gates notify).
                            Cron runs this every 10 minutes (bin/install-autostart).
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(root / "bin"))
import codex_run as cr  # noqa: E402


def models_for(it):
    return [m for m, _ in cr.PROFILES["gate" if it.get("gate") else it["script"]]]


def is_ancestor(a, b):
    return subprocess.call(["git", "merge-base", "--is-ancestor", a, b], cwd=root,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0


def review_parts(argv):
    """[--head SHA, BASE, FOCUS?] -> (head, base, focus) for routine reviews."""
    i = argv.index("--head")
    rest = argv[i + 2:]
    return argv[i + 1], (rest[0] if rest else "main"), (rest[1] if len(rest) > 1 else "")


def plan(items):
    """Return [(item, argv_to_run, merged_ids)]: routine reviews on one history line run as one."""
    reviews = [it for it in items if it["script"] == "review" and not it.get("gate") and "--head" in it["argv"]]
    out, merged = [], set()
    if len(reviews) > 1:
        # The newest head is the one the most other heads are ancestors of (by git history, not
        # queue order: items queued in the same second sort by a random id).
        heads = [review_parts(it["argv"])[0] for it in reviews]
        newest_head = max(heads, key=lambda h: sum(is_ancestor(o, h) for o in heads))
        line = [it for it in reviews if is_ancestor(review_parts(it["argv"])[0], newest_head)]
        if len(line) > 1:
            first = line[0]
            _, base, _ = review_parts(first["argv"])
            focus = " ; ".join(dict.fromkeys(f for f in (review_parts(it["argv"])[2] for it in line) if f))
            argv = ["--head", newest_head, base, focus]
            merged = {it["id"] for it in line[1:]}
            for it in items:
                if it is first:
                    out.append((it, argv, sorted(merged)))
                elif it["id"] not in merged:
                    out.append((it, it["argv"], []))
            return out
    return [(it, it["argv"], []) for it in items]


def drain():
    with cr.file_lock(".queue.lock", blocking=False) as got:
        if not got:
            print("another drain is running")
            return 0
        now = cr.now_utc()
        for it, argv, merged in plan(cr.queued_items()):
            nb = cr.parse_time(it.get("not_before"))
            if nb and nb > now:
                continue
            if all(cr.active_limit(m, now) for m in models_for(it)):
                continue  # its models are still unavailable; others may be free
            print(f"running {it['id']} ({it['script']}{' gate ' + it['gate'] if it.get('gate') else ''})"
                  f"{' + coalesced ' + ', '.join(merged) if merged else ''}", flush=True)
            p = subprocess.run([str(root / "bin" / f"codex-{it['script']}"), *argv], cwd=root, text=True,
                               capture_output=True, env={**os.environ, "CODEX_FROM_QUEUE": it["id"]})
            sys.stdout.write(p.stdout)
            sys.stderr.write(p.stderr)
            outs = re.findall(r"^(ops/codex/\S+\.md)$", p.stdout, re.M)
            out = outs[-1] if outs else None
            if p.returncode == 0:
                cr.resolve(it["id"], "done", out=out, coalesced=merged)
                for mid in merged:
                    cr.resolve(mid, "done", coalesced_into=it["id"], out=out)
            elif p.returncode in (cr.EXIT_QUEUED, cr.EXIT_GATE_BLOCKED):
                continue  # capped or limited again: stays queued, next item
            elif p.returncode == cr.EXIT_REFUSED:
                cr.resolve(it["id"], "dropped", exit=p.returncode)
            else:
                it["attempts"] = it.get("attempts", 0) + 1
                if it["attempts"] >= cr.QUEUE_MAX_ATTEMPTS:
                    cr.resolve(it["id"], "failed", exit=p.returncode, out=out)
                    if it.get("gate"):
                        cr.notify(f"Codex gate '{it['gate']}' failed {it['attempts']} times "
                                  f"(exit {p.returncode}); dropped from the queue. See {out or 'ops/codex/'}.",
                                  it["gate"])
                else:
                    it["not_before"] = (now + cr.QUEUE_RETRY_BACKOFF).isoformat()
                    cr.save_item(it)
    return 0


def show():
    for it in cr.queued_items():
        print(it["id"], it.get("gate") or "routine", it.get("reason"), json.dumps(it.get("argv")),
              f"attempts={it.get('attempts', 0)}", f"not_before={it.get('not_before')}")
    for m, d in cr.limits().items():
        if isinstance(d, dict):
            print(f"{d.get('kind', 'limit')} {m}: until {d.get('reset')} (parsed={d.get('reset_parsed')})")
    for n in cr.read_jsonl(cr.ops_dir() / "notify.jsonl"):
        if not n.get("sent"):
            print("NOTIFY (unsent):", n.get("message"))
    print(cr.summary())


if __name__ == "__main__":
    sys.exit(drain() if "--drain" in sys.argv else show())
