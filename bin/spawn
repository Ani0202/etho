#!/usr/bin/env bash
# Spawn an independent headless Claude Code session in its own git worktree.
# Usage: bin/spawn <name> <model: opus|sonnet|haiku> <effort: low|medium|high|xhigh> "<task prompt>"
# Result JSON (includes cost and session_id) lands in ops/sessions/<name>.json.
# Resume later with: claude --resume <session_id>
set -euo pipefail
[ $# -ge 4 ] || { echo "usage: bin/spawn <name> <model> <effort> \"<task>\""; exit 1; }
name=$1; model=$2; effort=$3; shift 3
root=$(git rev-parse --show-toplevel)
if ! git -C "$root" diff --quiet HEAD -- CLAUDE.md AGENTS.md .claude 2>/dev/null; then
  echo "warning: uncommitted changes to CLAUDE.md/AGENTS.md/.claude won't be visible in the worktree" >&2
fi
wt="$root/../etho-wt/$name"
mkdir -p "$root/ops/sessions"
git -C "$root" worktree add -B "agent/$name" "$wt" HEAD >/dev/null
task="$*

When finished: run the tests, commit on branch agent/$name, push the branch, and end with a short
report: what changed, test output, open issues, and EVERY action that was blocked or skipped by
permissions or the auto-mode classifier. Follow CLAUDE.md."
nohup bash -c 'cd "$1" && claude -p "$2" --model "$3" --effort "$4" --permission-mode auto --output-format json </dev/null' \
  _ "$wt" "$task" "$model" "$effort" \
  > "$root/ops/sessions/$name.json" 2> "$root/ops/sessions/$name.err" &
echo "spawned '$name' (pid $!) in $wt on branch agent/$name"
echo "watch: jq '{result, total_cost_usd, session_id}' ops/sessions/$name.json"
