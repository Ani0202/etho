#!/usr/bin/env bash
# Run by cron every 5 minutes and at boot. If the lead session's process has exited, resume it.
# Gives up after 3 restarts in 6 hours (writes ops/lead.disabled) so a broken login can't loop.
# Pause it with bin/lead-stop; re-enable with: rm ops/lead.disabled
root=$(cd "$(dirname "$0")/.." && pwd)
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin" LANG="${LANG:-C.UTF-8}"
log="$root/ops/watchdog.log"
tmux has-session -t etho 2>/dev/null && exit 0
[ -f "$root/ops/lead.disabled" ] && exit 0
[ -f "$root/ops/lead.started" ] || exit 0          # never started: nothing to resume
now=$(date +%s)
recent=$(awk -v t=$((now - 21600)) '$1 > t && /restart/' "$log" 2>/dev/null | wc -l)
if [ "$recent" -ge 3 ]; then
  echo "$now $(date -u +%FT%TZ) gave up after 3 restarts in 6h; rm ops/lead.disabled to re-enable" >> "$log"
  touch "$root/ops/lead.disabled"; exit 0
fi
echo "$now $(date -u +%FT%TZ) restart (process had exited)" >> "$log"
"$root/bin/lead-start" --resume >> "$log" 2>&1
